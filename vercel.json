{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/XFU",
      "destination": "/XFU/",
      "statusCode": 301
    },
    {
      "source": "/GupSpine",
      "destination": "/GupSpine/",
      "statusCode": 301
    },
    {
      "source": "/:path(interalia|InterAlia|Interalia|INTERALIA)",
      "destination": "/interalia/",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/GupSpine/",
      "destination": "https://gup-spine.vercel.app/"
    },
    {
      "source": "/GupSpine/:path*",
      "destination": "https://gup-spine.vercel.app/:path*"
    },
    {
      "source": "/XFU/",
      "destination": "https://app-alpha-ten-47.vercel.app/"
    },
    {
      "source": "/XFU/:path*",
      "destination": "https://app-alpha-ten-47.vercel.app/:path*"
    },
    {
      "source": "/interalia/",
      "destination": "https://interalia.vercel.app/"
    },
    {
      "source": "/interalia/:path*",
      "destination": "https://interalia.vercel.app/:path*"
    }
  ]
}
